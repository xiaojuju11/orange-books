{
  "name": "orange-books",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把每天学的东西，写成一本本可以读完的书",
  "scripts": {
    "dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "note": "node scripts/new-note.mjs",
    "check": "node scripts/check-books.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify": "npm run check && npm test && npm run docs:build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  }
}
